# Development-only PostgreSQL configuration. Never use this password in production.
POSTGRES_DB=indusscript_ai
POSTGRES_USER=indusscript
POSTGRES_PASSWORD=indusscript_dev_only
POSTGRES_PORT=5432

# Server-side Next.js database connection. Do not prefix this value with NEXT_PUBLIC_.
DATABASE_URL=postgresql://indusscript:indusscript_dev_only@localhost:5432/indusscript_ai
